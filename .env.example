# Trajecta environment — copy to .env (never commit .env)
# Managed Bifrost: installer creates a persistent virtual key in
# %LOCALAPPDATA%\ai.trajecta.desktop\data\bifrost\virtual-key
# and passes it to both services. Never set a guessed key like sk-bf-trajecta.
# External Bifrost only: configure BIFROST_VIRTUAL_KEY with an ACTUAL registered key.
BIFROST_URL=http://127.0.0.1:8080
# BIFROST_VIRTUAL_KEY=sk-bf-<registered-virtual-key>
# Providers and their API keys are configured in the Bifrost dashboard.

# Optional direct-provider integrations (not used by managed Bifrost)
# TRAJECTA_OPENAI_API_KEY=
# TRAJECTA_ANTHROPIC_API_KEY=

# 9Router credentials belong in Bifrost Dashboard > Providers > 9router.
# This variable is useful for direct 9Router diagnosis ONLY; it is NOT
# automatically imported into managed Bifrost's provider settings.
# TRAJECTA_9_ROUTER_API_KEY=9r_<real-9router-api-key>
# Model to route to — user can swap anytime (default defined in config/default.yaml)
TRAJECTA_9_ROUTER_MODEL=claude-opus-free
