# Trajecta environment — copy to .env (never commit .env)
# Bifrost virtual key — Python app authenticates to Bifrost with this.
# Create it in the Bifrost UI (http://localhost:8080)
BIFROST_URL=http://127.0.0.1:8080
BIFROST_VIRTUAL_KEY=sk-bf-trajecta
# Bifrost reads provider credentials itself from config/bifrost/config.yaml.

# Direct-mode fallback (used only when Bifrost is disabled)
# TRAJECTA_OPENAI_API_KEY=
# TRAJECTA_ANTHROPIC_API_KEY=